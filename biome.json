{
	"$schema": "https://biomejs.dev/schemas/2.6.7/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"includes": ["**", "!.release-please-manifest.json", "!CHANGELOG.md"]
	},
	"json": {
		"linter": {
			"enabled": true
		},
		"formatter": {
			"enabled": true
		}
	},
	"yaml": {
		"linter": {
			"enabled": false
		},
		"formatter": {
			"enabled": false
		}
	}
}
